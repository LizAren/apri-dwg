# ============================================================================
#  Regole del server per la sezione DWG.
#
#  🔴 Il motivo per cui questo file esiste: Altervista comprime il JavaScript
#  ma NON il `.wasm`. Misurato sul sito vero — 9.960.337 byte serviti tali e
#  quali, senza `content-encoding`. Erano 9,5 MB scaricati da ogni visitatore
#  che apre un DWG invece dei 2,3 MB compressi, cioè quattro volte il traffico
#  e quattro volte l'attesa. Il numero «2,26 MB» misurato in locale non era
#  quello che riceveva la gente.
#
#  Il tipo MIME `application/wasm` non è nell'elenco di quelli compressi, e va
#  aggiunto a mano.
# ============================================================================

#  ⚠️ Chiederlo a mod_deflate NON funziona su questo host: provato, il file
#  continuava ad arrivare intero mentre la regola di cache qui sotto veniva
#  applicata regolarmente. Quindi la copia compressa la prepara la
#  pubblicazione (`strumenti/comprimi.mjs`) e qui la si serve al posto
#  dell'originale a chi accetta gzip. Se la riscrittura non scattasse, il
#  browser riceve il .wasm normale e funziona lo stesso, solo più lento.

# 🔴 Prima di tutto: si va in HTTPS. Senza questa regola il sito rispondeva 200
# anche su http://, e da lì la password dell'accesso e il token di sessione
# viaggerebbero in chiaro su qualsiasi rete. Misurato, non supposto.
# Le due condizioni servono perché il TLS può essere chiuso a monte: in quel
# caso %{HTTPS} è off ma l'intestazione dice come è arrivata la richiesta.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# La pagina non si lascia incorniciare da altri siti: un accesso dentro un
# iframe altrui è il modo classico per far cliccare «entra» a chi non voleva.
#
# 🔴 MISURATO: su questo host queste intestazioni NON arrivano al browser, né
# al livello della cartella né dentro `FilesMatch`. Altervista sovrascrive le
# intestazioni di pagine e script con le proprie (sul `.wasm`, dove non ne
# mette, le nostre passano: la cache di un anno funziona). Restano scritte
# perché non fanno danno e varranno se un giorno l'host cambia — ma la difesa
# dalla cornice è nel JavaScript, in src/main.js, che non dipende dal server.
<FilesMatch "\.(html|php)$">
  <IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:Accept-Encoding} gzip
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.gz -f
  RewriteRule ^(.*)\.wasm$ $1.wasm.gz [L]
</IfModule>

<FilesMatch "\.wasm\.gz$">
  ForceType application/wasm
  <IfModule mod_headers.c>
    Header set Content-Encoding gzip
    Header append Vary Accept-Encoding
  </IfModule>
</FilesMatch>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/javascript text/javascript text/css text/html image/svg+xml
</IfModule>

# I nomi degli asset contengono l'impronta del contenuto: se cambia il file
# cambia il nome, quindi si possono tenere in cache per sempre senza rischiare
# di servire una versione vecchia.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/wasm "access plus 1 year"
</IfModule>
<FilesMatch "\.(wasm|js|css)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable"
  </IfModule>
</FilesMatch>

# La pagina invece non si mette in cache: è il file che cambia a ogni
# pubblicazione e che porta i nomi nuovi degli asset.
<FilesMatch "^index\.html$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache"
  </IfModule>
</FilesMatch>

<IfModule mod_mime.c>
  AddType application/wasm .wasm
</IfModule>
